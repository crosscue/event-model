{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crosscue Event Model Core Event 0.1",
  "description": "Structural JSON schema for a Crosscue Event Model Core 0.1 event (package 0.1.1; wire xq_version 0.1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "xq_version",
    "id",
    "event_time",
    "source",
    "modality",
    "class",
    "feature",
    "action",
    "polarity"
  ],
  "properties": {
    "xq_version": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "event_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "observed_time": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9._-]*$",
      "description": "Qualified semantic identifier for the collection/domain modality. Registered Core terms use xq:."
    },
    "class": {
      "enum": [
        "observation",
        "normalized_observation",
        "transition",
        "derived",
        "fusion",
        "assessment"
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9._-]*$",
      "description": "Qualified identifier for a published profile claim, for example xq.mob:profile-0.1."
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "object": {
      "type": "string",
      "minLength": 1
    },
    "feature": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9._-]*$",
      "description": "Qualified semantic identifier for the concept or phenomenon. Registered Core terms use xq:."
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9._-]*$",
      "description": "Qualified semantic identifier for the occurrence or change. Registered Core terms use xq:."
    },
    "state": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9.-]*:[a-z][a-z0-9._-]*$",
      "description": "Optional qualified semantic identifier for state. Registered Core terms use xq:."
    },
    "polarity": {
      "type": "integer",
      "enum": [
        -1,
        0,
        1
      ]
    },
    "magnitude": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "$ref": "#/$defs/location"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "markings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "dependentRequired": {
    "magnitude": [
      "unit"
    ]
  },
  "allOf": [
    {
      "if": {
        "required": [
          "object"
        ]
      },
      "then": {
        "required": [
          "subject"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "location": {
            "required": [
              "alt"
            ]
          }
        },
        "required": [
          "location"
        ]
      },
      "then": {
        "properties": {
          "location": {
            "required": [
              "alt_unit"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lat",
        "lon"
      ],
      "properties": {
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "alt": {
          "type": "number"
        },
        "alt_unit": {
          "type": "string",
          "minLength": 1
        },
        "accuracy_m": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "producer_version": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "parents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_records": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "parameters": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
